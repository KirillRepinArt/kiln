{
  "name": "kiln",
  "private": true,
  "description": "Development tools only. Kiln itself needs nothing from npm: it runs from the files in app/ and server/.",
  "type": "module",
  "scripts": {
    "lint": "eslint && stylelint \"app/**/*.css\" && prettier --check . && tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tools/tests/run.mjs",
    "privacy": "python tools/privacy_scan.py --all",
    "typecheck": "tsc -p .",
    "test:unit": "node --test \"tools/tests/unit/*.test.mjs\"",
    "test:server": "python -m unittest discover -s tools/tests/unit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "7.0.2"
  }
}
