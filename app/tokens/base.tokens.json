{
  "$description": "Kiln · the styles. index.html loads these files in this order (the order matters where rules meet):\n   tokens · base · layout · scrolledge · prompt · controls · chips · tabs · picture · queue · loras · pnginfo · dialogs ·\n   overlays · glass · themes/* · motion. One rule per thing, grouped by part of the screen.\n   States are classes JS sets (body.glass / .private / .jobrun…, .app.stacked / .pright, .frame.has / .held…).\n   !important is kept only where a rule must beat an inline style or every other rule (cursor and transition\n   switches while you drag, the morph); each one says why. */\n/* ======================= tokens =======================",
  "$extensions": {
    "dev.kiln": {
      "format": "DTCG 2025.10; CSS expressions the format can't type are marked dev.kiln.css"
    }
  },
  "role": {
    "$extensions": {
      "dev.kiln": {
        "prefix": ""
      }
    },
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "hex": "#000000"
      }
    },
    "text": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.929412, 0.929412, 0.929412],
        "hex": "#ededed"
      }
    },
    "muted": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.721569, 0.721569, 0.741176],
        "hex": "#b8b8bd"
      }
    },
    "faint": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.647059, 0.647059, 0.670588],
        "hex": "#a5a5ab"
      },
      "$description": "the quietest text that still reads 4.5:1 on a panel or a row (legibility.test.mjs)"
    },
    "sel": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "tw": {
      "$value": "6%",
      "$extensions": {
        "dev.kiln": {
          "css": true,
          "above": "the greys lean a few percent toward the theme, so a skin feels whole (--tw = strength)"
        }
      }
    },
    "panel": {
      "$value": "color-mix(in oklab, #1c1c1e, var(--a1) {role.tw})",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      }
    },
    "raised": {
      "$value": "color-mix(in oklab, #2a2a2d, var(--a1) {role.tw})",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      }
    },
    "raised2": {
      "$value": "color-mix(in oklab, #343438, var(--a1) {role.tw})",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      }
    },
    "line": {
      "$value": "color-mix(in oklab, #333338, var(--a1) {role.tw})",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      }
    },
    "row": {
      "$value": "color-mix(in oklab, #232326, var(--a1) {role.tw})",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      },
      "$description": "a row on a panel (the Queue): dark enough for --faint"
    },
    "shown": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.764706, 0.784314, 0.8],
        "hex": "#c3c8cc"
      },
      "$extensions": {
        "dev.kiln": {
          "above": "a shown job's settings and LoRAs: dimmer than your draft's, still 4.5:1 (legibility.test.mjs)"
        }
      }
    },
    "shown-label": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.705882, 0.729412, 0.745098],
        "hex": "#b4babe"
      }
    },
    "sky-shadow": {
      "$value": "0 0 1px {black.70}, 0 0 4px {black.60}, 0 0 14px rgba(0, 0, 0, 0.45)",
      "$extensions": {
        "dev.kiln": {
          "css": true,
          "above": "text on the bare sky (.onsky, no material behind it): a halo shaped like its letters, as on a wallpaper's labels"
        }
      }
    },
    "sky-shadow-icon": {
      "$value": "drop-shadow(0 0 1px {black.70}) drop-shadow(0 0 4px {black.60}) drop-shadow(0 0 14px rgba(0, 0, 0, 0.45))",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      }
    },
    "shown-name": {
      "$value": "{grey.69}",
      "$extensions": {
        "dev.kiln": {
          "above": "a shown picture's title line (the #, the name, the number and .png): greyed against your draft's white"
        }
      }
    },
    "grad": {
      "$value": "linear-gradient(135deg in oklch, var(--a1), var(--a2) 55%, var(--a3))",
      "$extensions": {
        "dev.kiln": {
          "css": true,
          "above": "the theme's colours --a1 --a2 --a3 --ink: in its skin file (themes/)"
        }
      }
    },
    "flow": {
      "$value": "linear-gradient(90deg in oklch, var(--a1), var(--a2), var(--a3), var(--a2), var(--a1))",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      }
    },
    "inset-box": {
      "$value": "{space.7}",
      "$extensions": {
        "dev.kiln": {
          "above": "text inside a box: this far from the box's outer edge to the letters, on every side"
        }
      }
    },
    "outline-out": {
      "$value": "min({gap.part}, calc(({gap.area} - {space.1}) / 2))",
      "$extensions": {
        "dev.kiln": {
          "css": true,
          "above": "OUTLINES — one rule: something you move or resize = a dashed line one part gap OUTSIDE its plate, the corners\n     concentric; a place to drop = a plate with the line one part gap INSIDE (the scripts read --outline-out too).\n     A divider outlines both panes it resizes: the two lines run as a pair one scale step apart down its middle, never\n     crossing — so never more than half of (the gap less one step)",
          "property": {
            "syntax": "<length>",
            "inherits": true,
            "initial": "12px"
          },
          "propertyNote": "the outline's offset is a length the scripts read (tokens.js): registered, its min() resolves to px"
        }
      }
    },
    "band-in": {
      "$value": "{space.px}",
      "$extensions": {
        "dev.kiln": {
          "above": "a resize band reaches this far inside its pane's edge (B19). A corner has ONE owner: the top / bottom band takes\n     it, a side band runs between them (L5: both claimed the corner's square — the pointer went to whichever was on top)"
        }
      }
    },
    "mat": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$extensions": {
        "dev.kiln": {
          "above": "the picture's mat: how far it sits inside its glass plate (the plate's ring shows round it). 0 = edge to edge,\n     the ring drawn over the picture (the rim, plate.js). The picture's corners stay concentric with the plate's"
        }
      }
    },
    "outline": {
      "$value": "1px dashed {white.28}",
      "$extensions": {
        "dev.kiln": {
          "css": true
        }
      }
    },
    "scrollbar": {
      "$type": "dimension",
      "$value": {
        "value": 15,
        "unit": "px"
      },
      "$description": "the scrollbars' width (base.css): the prompt keeps its text column when one appears"
    },
    "white": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      },
      "$extensions": {
        "dev.kiln": {
          "above": "COLOURS — white and black at the opacities in use: glass highlights, lines, shadows (the number = opacity %)"
        }
      }
    },
    "black": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "hex": "#000000"
      }
    },
    "on-picture": {
